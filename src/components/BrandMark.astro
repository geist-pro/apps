---
/** The GEIST ghost, drawn for the --brand-bar surface (header and footer). Decorative: the wordmark carries the name. */
export interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<svg class="brand-mark" viewBox="0 0 256 256" width={size} height={size} aria-hidden="true" focusable="false">
  <polygon fill="var(--on-brand)" points="25.2,242.8 26.3,97.3 51,41.6 128.5,12.9 202,39.1 229.3,94.4 231.8,243.1 183.1,199.1 128.5,241.3 74.3,199.1"></polygon>
  <circle fill="var(--brand-bar)" cx="91.9" cy="99.8" r="21.1"></circle>
  <circle fill="var(--accent)" cx="166.1" cy="99.8" r="21.1"></circle>
</svg>
